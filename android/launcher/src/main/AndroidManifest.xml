<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- hosted wallpapers, the optional card -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- the optional home-screen card reads the screensaver's settings (signature permission, same key) -->
    <uses-permission android:name="sa.urtv.screensaver.READ_CONFIG" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="sa.urtv.screensaver" />
    </queries>

    <!-- shows «مين يشاهد اليوم؟» when the TV wakes, from the background (granted over ADB at install) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- «التطبيقات المفتوحة»: recent apps (appops GET_USAGE_STATS over ADB), closing and removing them -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- «الواجهة الرئيسية الثابتة»: open after a restart; turn its own keeper service on (granted over ADB) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="AZ TV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- also an app tile, so a TV that got the APK from the website can open it the first time -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «ترتيب المفضلة»: the favourites as a list; also opened from the screensaver's settings -->
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- «مين يشاهد اليوم؟»: accounts; also opened from the screensaver's settings -->
        <activity
            android:name=".ProfilesActivity"
            android:exported="true"
            android:label="مين يشاهد اليوم؟"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Home" />

        <!-- «صور الحساب»: QR code and the page for sending photos from a phone -->
        <activity
            android:name=".PhotosActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Home" />

        <!-- «الإعدادات»: the home screen's own settings, glass like the home screen -->
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Home" />

        <!-- «التطبيقات المفتوحة»: the iPhone-style app switcher -->
        <activity
            android:name=".RecentsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Home" />

        <!-- the active account's photos for the screensaver; callers are checked against our signature -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="sa.urtv.home.photos"
            android:exported="true" />

        <!-- favourites row from ADB (agents, optimize/dock.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_DOCK" />
                <action android:name="sa.urtv.home.LIST_APPS" />
                <action android:name="sa.urtv.home.SET_DOCK" />
                <action android:name="sa.urtv.home.RESET_DOCK" />
            </intent-filter>
        </receiver>

        <!-- «الواجهة الرئيسية الثابتة»: puts AZ TV back whenever the TV's own home comes up -->
        <service
            android:name=".HomeKeeper"
            android:label="AZ TV: الواجهة الثابتة"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_keeper" />
        </service>

        <receiver
            android:name=".HomeKeeper$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
